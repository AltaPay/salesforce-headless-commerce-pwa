COMMERCE_API_CLIENT_ID=""
COMMERCE_API_ORG_ID=""
COMMERCE_API_SHORT_CODE=""
COMMERCE_API_SITE_ID=""
COMMERCE_API_DEFAULT_SITE=""
SCAPI_URL=""
OCAPI_URL=""
SFCC_HOST=""

# Secret for the private SLAS client (COMMERCE_API_CLIENT_ID), used by the storefront itself.
PWA_KIT_SLAS_CLIENT_SECRET=""
DEFAULT_CURRENCY="EUR"
SUPPORTED_CURRENCIES="EUR"
DEFAULT_LOCALE="en-GB"
# Account Manager API client used to get the token for the SCAPI callback endpoints.
ADMIN_CLIENT_ID_PRIVATE=""
ADMIN_CLIENT_SECRET=""
# Realm and instance the token is issued for, e.g. bknt_005
SFCC_REALM_AND_INSTANCE=""
# Scopes requested for that token
SFCC_OAUTH_SCOPES="c_marketpaycallbacks_rw sfcc.custom-apis"

# Where the shopper is redirected if a webhook callback can't be processed
MARKETPAY_DEFAULT_ERROR_URL=""

# Restrict /webhooks/marketpay/* callbacks to MarketPay's known IP ranges.
MARKETPAY_KNOWN_IP_PROTECTION=true

# Number of trusted proxies (CDN, load balancer) in front of this app, used to resolve the real
# caller IP for MARKETPAY_KNOWN_IP_PROTECTION. Must match your proxy chain exactly.
# Leave unset when there is no proxy (e.g. local development). Apps importing the module must
# set trust proxy themselves, as ssr.js does here.
# MARKETPAY_TRUSTED_PROXY_HOPS=

# Verify that incoming webhook callbacks are genuinely from MarketPay.
# Defaults to true; set to "false" to disable. When enabled,
# MARKETPAY_CALLBACK_SECRET must also be set, or every callback is rejected.
MARKETPAY_SIGNATURE_PROTECTION=true

# Shared secret used to verify that incoming webhook callbacks are genuinely
# from MarketPay. Must match the secret configured on the MarketPay side -
# see https://documentation.altapay.com/v2/Checkout-API/CallbackSecurity/
MARKETPAY_CALLBACK_SECRET=""